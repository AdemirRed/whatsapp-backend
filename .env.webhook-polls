# CONFIGURAÇÃO PARA CAPTURAR VOTOS DE ENQUETES VIA WEBHOOK
# 
# A biblioteca whatsapp-web.js já possui suporte nativo para o evento 'vote_update'
# que é disparado sempre que alguém vota em uma enquete.

## Application ##
PORT=200
API_KEY=redblack
# Configure sua URL de webhook onde você quer receber as notificações de votos
BASE_WEBHOOK_URL=http://localhost:3001/webhook/vote
ENABLE_LOCAL_CALLBACK_EXAMPLE=FALSE
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=1000

## Client ##
MAX_ATTACHMENT_SIZE=10000000
SET_MESSAGES_AS_SEEN=TRUE

# IMPORTANTE: NÃO inclua 'vote_update' nos callbacks desabilitados
# para garantir que você receba as notificações de votos
DISABLED_CALLBACKS=message_ack|message_reaction

WEB_VERSION='2.2328.5'
WEB_VERSION_CACHE_TYPE=none
RECOVER_SESSIONS=TRUE

## Session File Storage ##
SESSIONS_PATH=./sessions

ENABLE_SWAGGER_ENDPOINT=TRUE

# EVENTOS DISPONÍVEIS QUE PODEM SER CAPTURADOS VIA WEBHOOK:
# - vote_update: Quando alguém vota em uma enquete
# - message_create: Quando uma nova mensagem é criada (incluindo enquetes)
# - message: Quando uma mensagem é recebida
# - ready: Quando a sessão está pronta
# - qr: Para autenticação QR Code
# - authenticated: Quando autenticado com sucesso
# 
# Para enquetes, o mais importante é o 'vote_update'