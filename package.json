{
  "name": "whatsapp-web-api",
  "version": "1.0.0",
  "description": "REST API wrapper for whatsapp-web.js",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --runInBand",
    "swagger": "node swagger.js",
    "build": "pkg . --out-path dist/",
    "build:win": "pkg . --targets node18-win-x64 --out-path dist/ --no-bytecode --public-packages=axios,express,whatsapp-web.js",
    "build:linux": "pkg . --targets node18-linux-x64 --out-path dist/",
    "build:mac": "pkg . --targets node18-macos-x64 --out-path dist/",
    "build:all": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path dist/"
  },
  "dependencies": {
    "axios": "^1.13.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^6.11.2",
    "form-data": "^4.0.4",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.37.2",
    "qr-image": "^3.2.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.5",
    "swagger-ui-express": "^5.0.1",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js#v1.34.6",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "eslint": "^8.38.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.5.0",
    "pkg": "^5.8.1",
    "supertest": "^6.3.3",
    "swagger-autogen": "^2.23.7"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "api",
    "wrapper",
    "rest",
    "express",
    "axios"
  ],
  "author": "Christophe Hubert",
  "license": "MIT",
  "engines": {
    "node": ">=14.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chrishubert/whatsapp-web-api.git"
  },
  "bugs": {
    "url": "https://github.com/chrishubert/whatsapp-web-api/issues"
  },
  "homepage": "https://github.com/chrishubert/whatsapp-web-api",
  "private": true,
  "pkg": {
    "assets": [
      ".env.example",
      "node_modules/whatsapp-web.js/**/*",
      "node_modules/puppeteer/**/*"
    ],
    "scripts": [
      "src/**/*.js",
      "swagger.js",
      "node_modules/axios/**/*.js",
      "node_modules/express/**/*.js",
      "node_modules/whatsapp-web.js/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist/"
  }
}
