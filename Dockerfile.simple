# Dockerfile otimizado para Render com persistência de sessões robusta
FROM node:18-alpine

# Instalar dependências do sistema
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    curl \
    dumb-init \
    bash \
    util-linux

# Configurar variáveis de ambiente
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    CHROME_BIN=/usr/bin/chromium-browser \
    NODE_ENV=production

# Criar usuário não-root
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Definir diretório de trabalho
WORKDIR /app

# Criar diretório para sessões com permissões corretas
RUN mkdir -p /app/sessions && \
    chown -R nextjs:nodejs /app && \
    chmod -R 755 /app/sessions

# Copiar package files
COPY --chown=nextjs:nodejs package*.json ./

# Instalar dependências
RUN npm ci --only=production && npm cache clean --force

# Copiar código fonte e script de inicialização
COPY --chown=nextjs:nodejs . .
COPY --chown=nextjs:nodejs start.sh ./

# Dar permissão de execução ao script
RUN chmod +x start.sh

# Mudar para usuário não-root
USER nextjs

# Verificar que o diretório de sessões existe e tem permissões
RUN ls -la /app/sessions && \
    echo "Testando escrita..." && \
    touch /app/sessions/.test && \
    rm /app/sessions/.test && \
    echo "✅ Diretório de sessões OK"

# Volume para persistência (será sobrescrito pelo mount do Render)
VOLUME ["/app/sessions"]

# Usar dumb-init para handle signals correctly
ENTRYPOINT ["dumb-init", "--"]

# Comando para iniciar aplicação usando o script
CMD ["./start.sh"]
